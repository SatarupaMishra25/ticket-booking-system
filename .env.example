# ---------------------------------------------------------------------------
# Database — Neon Postgres (https://neon.tech).  Use the POOLED connection
# string; it is the one that works on serverless hosts like Vercel.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth — any long random string.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string"

# Protects the /api/cron/* sweeper endpoints from public access.
CRON_SECRET="replace-with-another-random-string"

# ---------------------------------------------------------------------------
# Email.  Two backends are supported; pick one with EMAIL_PROVIDER, or leave it
# unset to auto-detect (SMTP wins if configured).  With neither configured the
# app still runs and just logs the messages it would have sent.
#
#   smtp   - any SMTP account.  Delivers to ANY recipient, so this is what a
#            live demo should use.  For Gmail: turn on 2-Step Verification,
#            then create an App Password at
#            https://myaccount.google.com/apppasswords
#            (that 16-character code is SMTP_PASS - not your Gmail password).
#
#   resend - https://resend.com.  Easiest to set up, but on the free tier
#            without a verified domain it only delivers to the address that
#            owns the Resend account.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="smtp"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Must stay onboarding@resend.dev on Resend's free tier.
# For SMTP, use the same address as SMTP_USER.
EMAIL_FROM="Ticket Booking <you@gmail.com>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# How long a seat stays held during checkout before auto-release.
SEAT_HOLD_TTL_MINUTES="10"

# How long a waitlist customer has to complete a booking from their offer email.
WAITLIST_OFFER_TTL_MINUTES="30"
